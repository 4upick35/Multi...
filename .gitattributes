# Нормализация переводов строк: в репозитории — LF.
* text=auto eol=lf

# Windows-скрипты остаются с CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Бинарные файлы — без преобразований
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.keystore binary
*.apk binary
*.aab binary
*.jar binary
