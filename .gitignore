# MultiElma: чувствительные и производные файлы (не для git)
.bundle/
*.log
docs/
release/
# JS-бандл генерируется при сборке (createBundleReleaseJsAndAssets)
android/app/src/main/assets/index.android.bundle
android/app/src/main/assets/index.android.bundle.meta

